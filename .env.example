# Copy to .env at the monorepo root — docker compose reads it automatically.
# Never commit the real .env.

# Public port of the website (nginx -> React SPA + /api proxy)
WEB_PORT=8080

# MongoDB connection string.
# Leave empty to use the bundled MongoDB container (docker compose --profile local-mongo up).
# For a free hosted database, create an Atlas M0 cluster (https://www.mongodb.com/atlas)
# and paste your connection string here, e.g.:
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/smart_healthcare
# When set, the bundled mongo container is not started.
MONGO_URI=

# Backend security — change JWT_SECRET for anything real
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# CORS: origins allowed to call the API directly (comma-separated)
CORS_ORIGIN=http://localhost:8080

# Where the built frontend calls the API from (relative path proxied by nginx)
VITE_API_URL=/api

# Notifications (console = dev preview; use smtp for real email)
EMAIL_TRANSPORT=console
EMAIL_FROM=Smart Healthcare Assistant <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Reminder scheduler (background job)
RUN_REMINDER_SCHEDULER=true
REMINDER_LEAD_HOURS=24
REMINDER_CHECK_INTERVAL_MINUTES=5

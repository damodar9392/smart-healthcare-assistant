PORT=8000
MODEL_PATH=models/
DATA_PATH=data/
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
LOG_LEVEL=info

# PRIVACY: whether to allow third-party (Google) translation of user messages.
# User messages may contain health data, so this is OFF by default.
# When OFF, the assistant replies in English / the 16 built-in languages only
# and never sends user text outside the system. Set to "true" ONLY if you
# accept transmitting user text to translate.googleapis.com.
TRANSLATE_ENABLED=false

# OpenAI GPT-4o assistant
# Leaving OPENAI_API_KEY empty keeps the built-in offline rule engine (no health
# data leaves this server). To enable GPT-4o, set the key below. Your user
# messages (which may contain health information) will then be sent to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_TOKENS=600

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/smart_healthcare
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# At-rest encryption for chat conversations and other sensitive fields.
# Use a SEPARATE, long random secret (>= 32 chars), NOT the same as JWT_SECRET.
# If unset or shorter than 32 chars, sensitive writes fail closed rather than
# storing plaintext.
ENCRYPTION_KEY=change-me-use-a-long-random-string-at-least-32-chars
# Comma-separated allowed origins, or * in development
CORS_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Notifications (see docs/notifications.md)
# EMAIL_TRANSPORT=console | smtp   (console = dev preview, default)
EMAIL_TRANSPORT=console
EMAIL_FROM=Smart Healthcare Assistant <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Reminder scheduler (background job)
RUN_REMINDER_SCHEDULER=true
REMINDER_LEAD_HOURS=24
REMINDER_CHECK_INTERVAL_MINUTES=5

# Online payments. mock = instant simulated confirmations in development.
# manual = invoices start as "pending" until the patient presses pay.
PAYMENT_MODE=mock

# Telehealth video consultations (Jitsi Meet host). Rooms are created per
# appointment and open 15 minutes before the start time.
VIDEO_ENABLED=true
VIDEO_DOMAIN=meet.jit.si
VIDEO_ROOM_PREFIX=SmartCare
VIDEO_OPEN_MINUTES_BEFORE=15
VIDEO_ROOM_HOURS_AFTER=2

# Web push notifications (browser notifications). Required for push to work.
# Generate a key pair with: node scripts/generateVapid.js
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com